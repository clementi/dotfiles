#!/usr/bin/env sh

export OSFONTDIR="$HOME/.local/share/fonts/:$HOME/.fonts:/usr/share/fonts"

export TYPST_FONT_PATHS=./fonts

export FREEPLANE_JAVA_HOME="/usr/lib/jvm/default-java"

{{ $cf := rbw "Cloudflare API" -}}
export CLOUDFLARE_EMAIL={{ $cf.username | quote }}
export CLOUDFLARE_API_KEY={{ $cf.password | quote }}
export CLOUDFLARE_JEFFREYPRATTNET_ZONE_ID={{ $cf.ZoneID | quote }}

export GUILE_LOAD_PATH="/home/linuxbrew/.linuxbrew/share/guile/site/3.0"
export GUILE_LOAD_COMPILED_PATH="/home/linuxbrew/.linuxbrew/lib/guile/3.0/site-ccache"
export GUILE_SYSTEM_EXTENSIONS_PATH="/home/linuxbrew/.linuxbrew/lib/guile/3.0/extensions"

export PKG_CONFIG_PATH="/usr/lib/x86_64-linux-gnu/pkgconfig"

export EDITOR="/home/linuxbrew/.linuxbrew/bin/nvim"
